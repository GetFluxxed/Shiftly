# Copy this file to .env and replace placeholder values locally.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Use 0.0.0.0 when the hosting platform supplies the public network interface.
HOST=0.0.0.0
PORT=4173
DATABASE_URL=postgresql://shiftly:change-me@localhost:55432/shiftly
POSTGRES_USER=shiftly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shiftly
REPORT_COOLDOWN_SECONDS=60
# Set true when HTTPS is enabled in production.
SECURE_COOKIES=true
# Required to create stores and manager accounts from the sign-up page.
ADMIN_SIGNUP_KEY=replace-with-a-long-random-value

# Initial topology: one API process; do not increase until admission is shared.
WEB_CONCURRENCY=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=3
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT=5
WORKER_STALE_SECONDS=60
# Legacy default. Use external with coordinated migrations and a separate worker.
SHIFTLY_WORKER_MODE=embedded
